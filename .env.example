# --- Base MongoDB ---
# En dev : service MongoDB local (Windows).
# Pour Atlas : mongodb+srv://USER:MOTDEPASSE@cluster0.xxxxx.mongodb.net/topcar33?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1/top-car33
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Site ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Mails ---
# Laisser SMTP_HOST vide en dev : Ethereal (aucun vrai envoi, lien d'aperçu dans le terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@topcar33.example
SMTP_FROM_NAME=TopCar33
