# --- Base MongoDB ---
# En dev : service MongoDB local (Windows).
# Pour Atlas : mongodb+srv://USER:MOTDEPASSE@cluster0.xxxxx.mongodb.net/topcar33?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1/top-car33
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Site ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Mails ---
# Laisser SMTP_HOST vide en dev : Ethereal (aucun vrai envoi). Les identifiants de la
# boîte de test s'affichent dans le terminal de npm run dev, à lire sur ethereal.email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=contact@topcar33.com
SMTP_FROM_NAME=TopCar33
